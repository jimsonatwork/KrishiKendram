{
  "registryId": "KK-AI-REGISTRY-001",
  "version": 4,
  "status": "CANONICAL",
  "modes": [
    "LOCAL",
    "CLOUD",
    "HYBRID",
    "DISABLED"
  ],
  "capabilities": [
    "CONVERSATION",
    "EXTRACTION",
    "VISION",
    "DOCUMENT",
    "SPEECH_TO_TEXT",
    "TEXT_TO_SPEECH",
    "FACT_MATCHING",
    "CONSISTENCY",
    "CLASSIFICATION",
    "RECOMMENDATION",
    "AGRI_ASSISTANT"
  ],
  "contextPolicy": {
    "id": "KK-AI-CONTEXT-001",
    "defaultMode": "MINIMUM_NECESSARY",
    "authorizationBeforeContext": true,
    "forbidden": [
      "FULL_USER_RECORD_BY_DEFAULT",
      "UNAUTHORIZED_CROSS_MODULE_CONTEXT",
      "DIRECT_AI_DATABASE_WRITE",
      "SECRET_CONTEXT"
    ]
  },
  "conversation": {
    "moduleId": "KK-AI-CONVERSATION-001",
    "requiredReferences": [
      "userId",
      "moduleId"
    ],
    "optionalReferences": [
      "screenId",
      "entityType",
      "entityId",
      "farmId",
      "cropId",
      "cropCycleId",
      "livestockId",
      "sessionId"
    ],
    "entities": [
      "Conversation",
      "ConversationSession",
      "ConversationMessage",
      "ConversationContext",
      "ConversationReference",
      "ConversationFactCandidate",
      "ConversationAction"
    ],
    "factLifecycle": [
      "DETECTED",
      "NORMALIZED",
      "VALIDATION_PENDING",
      "CONFLICT",
      "AWAITING_CONFIRMATION",
      "CONFIRMED",
      "REJECTED",
      "APPLIED",
      "SUPERSEDED",
      "EXPIRED"
    ]
  },
  "moduleContract": {
    "required": [
      "moduleName",
      "allowedCapabilities",
      "contextReferences",
      "allowedFields",
      "restrictedFields",
      "candidateFactTargets",
      "applyFields",
      "confirmationPolicy",
      "provenancePolicy",
      "auditPolicy"
    ],
    "initialModules": [
      "KK-USER-001",
      "KK-FARM-001",
      "KK-CROP-001",
      "KK-LIVESTOCK-001",
      "KK-MARKETPLACE-001"
    ],
    "storage": "CENTRAL_MODULE_FILES",
    "moduleDirectory": "../modules"
  },
  "modules": {},
  "providerRules": {
    "primaryExecution": "LOCAL",
    "cloudFallback": false,
    "databaseWriteAllowed": false,
    "registryValidationRequired": true,
    "userConfirmationRequired": true,
    "rawConversationTraining": false,
    "approvedLearningPipelineRequired": true
  },
  "provenanceRequired": [
    "providerId",
    "modelId",
    "modelVersion",
    "mode",
    "language",
    "source",
    "generatedAt"
  ],
  "godMode": {
    "visible": true,
    "controlAreas": [
      "providers",
      "models",
      "capabilities",
      "contextPolicies",
      "moduleAssociations",
      "fieldAccess",
      "conversationPolicy",
      "factPolicy",
      "confirmationPolicy",
      "provenance",
      "learningPolicy",
      "audit"
    ],
    "secretPolicy": "Never expose credentials or tokens."
  },
  "linkedFiles": {
    "providerInventory": "../providers/provider-inventory.json",
    "runtimeInventory": "../runtimes/runtime-inventory.json",
    "policyIndex": "../policies/ai-policy-index.json",
    "evaluationIndex": "../evaluations/evaluation-index.json",
    "governanceDocument": "../../docs/AI-VOICE-PLATFORM-AND-GOVERNANCE.md",
    "platformRegistryDocument": "../../docs/KK-AI-PLATFORM-REGISTRY.md",
    "conversationContextDocument": "../../docs/KK-AI-CONVERSATION-AND-CONTEXT.md",
    "supportingComponents": "../supporting-components.json",
    "voiceIntents": "../voice/voice-intents.json",
    "cloudConnectionPolicy": "../connections/cloud-connection-policy.json",
    "dataContextIntents": "../context/data-context-intents.json",
    "modelLinkRegistry": "../providers/model-link-registry.json",
    "optimizationPlanDocument": "../../docs/AI-PLATFORM-OPTIMIZATION-PLAN.md",
    "modelBenchmarkSuite": "../evaluations/KK-EVAL-LLM-001.json",
    "benchmarkRunner": "../../backend/scripts/kk-ai-benchmark.mjs",
    "executionArchitecture": "../../docs/AI-EXECUTION-ARCHITECTURE.md",
    "toolchainAdoptionReview": "../../docs/AI-TOOLCHAIN-ADOPTION-REVIEW.md"
  },
  "moduleFiles": {
    "KK-USER-001": "../modules/KK-USER-001.json",
    "KK-FARM-001": "../modules/KK-FARM-001.json",
    "KK-CROP-001": "../modules/KK-CROP-001.json",
    "KK-LIVESTOCK-001": "../modules/KK-LIVESTOCK-001.json",
    "KK-MARKETPLACE-001": "../modules/KK-MARKETPLACE-001.json",
    "KK-AI-CONVERSATION-001": "../modules/KK-AI-CONVERSATION-001.json"
  },
  "orchestration": {
    "intentSource": "../context/data-context-intents.json",
    "deterministicFirst": true,
    "deterministicResolversRequireAuthorization": true,
    "useLocalModelForFreeformOnly": true,
    "modelEvaluationChangesLiveSelection": false,
    "productionSwitchRequiresApprovedModel": true,
    "cloudFallback": false
  },
  "sharedResources": {
    "cropTerminology": {
      "resourceId": "KK-AI-CROP-TERMINOLOGY-001",
      "version": 1,
      "ownerModule": "KK-CROP-001",
      "implementation": "backend/src/ai/registry/crop-terminology.ts",
      "exposedBy": "GET /ai/conversations/voice-intents",
      "consumers": [
        "VoiceAgent",
        "IntakeExtractorService"
      ],
      "purpose": "Single source for crop aliases, planting verbs, spoken quantities and area units."
    }
  }
}
