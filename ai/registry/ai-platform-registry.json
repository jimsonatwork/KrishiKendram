    "optionalReferences": ["screenId", "entityType", "entityId", "farmId", "cropId", "cropCycleId", "livestockId", "sessionId"],
    "entities": ["Conversation", "ConversationSession", "ConversationMessage", "ConversationContext", "ConversationReference", "ConversationFactCandidate", "ConversationAction"],
