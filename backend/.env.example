NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/krishikendram
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:4000

# Local break-glass / bootstrap credential source. Never commit real values.
# Required only when initializing or explicitly recovering the canonical Super Admin.
SUPER_ADMIN_EMAIL=jimson@jimson.com
SUPER_ADMIN_PASSWORD=CHANGE_ME

# Optional operational settings
JWT_EXPIRES_IN=15m

# Local Ollama text-generation provider. Evaluation is disabled by default.
KK_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
KK_AI_OLLAMA_MODEL=qwen3:1.7b
KK_AI_OLLAMA_MODEL_VERSION=UNVERIFIED_LOCAL_MODEL
# Local CPU cold-start and prompt evaluation can take ~50s; still bounded at 120s.
KK_AI_OLLAMA_TIMEOUT_MS=120000
KK_AI_ALLOW_LOCAL_EVALUATION=false
KK_AI_OLLAMA_MODELS_DIR=/mnt/d/KrishiKendram/08-AI/KrishiKendram-AI/Models/Ollama
