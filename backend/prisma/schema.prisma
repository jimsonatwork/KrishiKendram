/**
 * KK-AI-CONVERSATION-FOUNDATION
 * Conversation is deliberately separate from canonical
 * User/module data.
 * AI may propose candidate facts, but never receives
 * direct canonical-write authority.
 */

model Conversation {
  id       String             @id @default(cuid())
  userId   String
  moduleId String
  status   ConversationStatus @default(ACTIVE)

  title           String?
  primaryLanguage String?

  startedAt     DateTime  @default(now())
  lastMessageAt DateTime?
  endedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)

  sessions       ConversationSession[]
  messages       ConversationMessage[]
  contexts       ConversationContext[]
  references     ConversationReference[]
  factCandidates ConversationFactCandidate[]
  actions        ConversationAction[]

  @@index([userId])
  @@index([moduleId])
  @@index([userId, moduleId])
  @@index([status])
  @@index([lastMessageAt])
}

model ConversationSession {
  id             String @id @default(cuid())
  conversationId String

  status            ConversationSessionStatus @default(ACTIVE)
  interruptionState String?
  discoveryState    Json?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messages       ConversationMessage[]
  contexts       ConversationContext[]
  factCandidates ConversationFactCandidate[]

  @@index([conversationId])
  @@index([status])
}

model ConversationMessage {
  id             String  @id @default(cuid())
  conversationId String
  sessionId      String?

  role     ConversationMessageRole
  content  String
  language String?

  source ConversationMessageSource @default(TEXT)

  providerId   String?
  modelId      String?
  modelVersion String?

  metadata   Json?
  provenance Json?

  createdAt DateTime @default(now())

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([sessionId, createdAt])
  @@index([role])
}

model ConversationContext {
  id             String  @id @default(cuid())
  conversationId String
  sessionId      String?

  moduleId   String
  screenId   String?
  entityType String?
  entityId   String?

  policyId      String?
  policyVersion String?

  contextSnapshot Json?
  createdAt       DateTime @default(now())

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([moduleId])
  @@index([moduleId, entityType, entityId])
}

model ConversationReference {
  id             String @id @default(cuid())
  conversationId String

  moduleId      String
  referenceType String
  entityType    String?
  entityId      String?
  relationship  String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([moduleId])
  @@index([entityType, entityId])
}

model ConversationFactCandidate {
  id             String  @id @default(cuid())
  conversationId String
  sessionId      String?

  userId   String
  moduleId String

  targetEntityType String?
  targetEntityId   String?
  targetFieldId    String?

  proposedValue Json
  previousValue Json?

  confidence Decimal? @db.Decimal(5, 4)

  source String
  status ConversationFactCandidateStatus @default(DETECTED)

  requiresConfirmation Boolean @default(true)

  confirmedAt       DateTime?
  confirmedByUserId String?

  validationResult  Json?
  evidenceReference String?
  provenance        Json?

  resolutionNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  appliedAt DateTime?

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      ConversationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  user            User  @relation("ConversationFactCandidateUser", fields: [userId], references: [id], onDelete: Cascade)
  confirmedByUser User? @relation("ConversationFactCandidateConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([sessionId])
  @@index([userId])
  @@index([moduleId])
  @@index([userId, moduleId])
  @@index([status])
  @@index([targetEntityType, targetEntityId])
  @@index([targetFieldId])
}

model ConversationAction {
  id             String @id @default(cuid())
  conversationId String
  moduleId       String

  actionType       String
  targetEntityType String?
  targetEntityId   String?

  payload Json?
  status  ConversationActionStatus @default(PROPOSED)

  proposedAt DateTime  @default(now())
  executedAt DateTime?
  executedBy String?

  result Json?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([moduleId])
  @@index([status])
  @@index([targetEntityType, targetEntityId])
}

model MarketplaceTaxProfile {
  id                     String    @id @default(cuid())
  sellerJurisdictionCode String
  buyerJurisdictionCode  String
  category               String
  taxCode                String
  taxName                String
  taxBase                String    @default("SUBTOTAL")
  basisPoints            Int
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  reviewReference        String?
  status                 String    @default("DRAFT")
  version                Int       @default(1)
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  retiredAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([sellerJurisdictionCode, buyerJurisdictionCode, category, effectiveFrom])
  @@index([status, effectiveFrom, effectiveTo])
  @@index([sellerJurisdictionCode, buyerJurisdictionCode, category, status])
}

model MarketplaceFeatureFlag {
  key          String   @id
  title        String
  description  String
  enabled      Boolean  @default(false)
  riskLevel    String   @default("LOW")
  dependencies String[] @default([])
  version      Int      @default(1)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, riskLevel])
}

model MarketplacePayment {
  id                String    @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String?
  idempotencyKey    String    @unique
  externalEventId   String?
  status            String    @default("CREATED")
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("INR")
  quoteSnapshot     Json
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order         MarketplaceOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ledgerEntries MarketplaceLedgerEntry[]
  events        MarketplacePaymentEvent[]
  refunds       MarketplaceRefund[]

  @@index([orderId, status, createdAt])
  @@index([provider, providerPaymentId])
  @@index([externalEventId])
}

model MarketplacePaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  provider        String
  externalEventId String
  status          String
  payloadHash     String
  receivedAt      DateTime @default(now())

  payment MarketplacePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([paymentId, receivedAt])
}

model MarketplaceRefund {
  id               String   @id @default(cuid())
  paymentId        String
  orderId          String
  createdById      String
  idempotencyKey   String   @unique
  providerRefundId String   @unique
  status           String   @default("REQUESTED")
  amount           Decimal  @db.Decimal(12, 2)
  currency         String
  reason           String
  externalEventId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment       MarketplacePayment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order         MarketplaceOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ledgerEntries MarketplaceLedgerEntry[]

  @@index([paymentId, status, createdAt])
  @@index([orderId, createdAt])
}

model MarketplaceSellerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  displayName       String?
  bio               String?
  regionLabel       String?
  contactPreference String   @default("IN_APP")
  publicPhone       String?
  showPhone         Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model MarketplaceFavorite {
  id        String             @id @default(cuid())
  userId    String
  listingId String
  status    String             @default("ACTIVE")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([userId, listingId])
  @@index([userId, status, updatedAt])
  @@index([listingId, status])
}

model MarketplaceMessage {
  id          String              @id @default(cuid())
  senderId    String
  recipientId String
  listingId   String?
  orderId     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  sender      User                @relation("MarketplaceMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User                @relation("MarketplaceMessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  listing     MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: Restrict)
  order       MarketplaceOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([senderId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([listingId, createdAt])
  @@index([orderId, createdAt])
}

model MarketplaceRFQ {
  id              String                   @id @default(cuid())
  buyerId         String
  title           String
  category        String
  description     String
  quantity        Float
  unit            String
  targetUnitPrice Decimal?                 @db.Decimal(14, 2)
  currency        String                   @default("INR")
  deliveryRegion  String?
  neededBy        DateTime?
  status          String                   @default("OPEN")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  buyer           User                     @relation("MarketplaceRFQBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  responses       MarketplaceRFQResponse[]

  @@index([status, category, createdAt])
  @@index([buyerId, status, createdAt])
