  sellerId      String
  orderId       String
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("INR")
  status        String    @default("ACTIVE")
  reason        String
  expiresAt     DateTime?
  createdById   String
  releasedById  String?
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([sellerId, status, expiresAt])
  @@index([orderId, status])
}

model MarketplaceReconciliationRun {
  id             String   @id @default(cuid())
  createdById    String
  status         String   @default("COMPLETED")
  currency       String   @default("INR")
  debitTotal     Decimal  @db.Decimal(16, 2)
  creditTotal    Decimal  @db.Decimal(16, 2)
  balanced       Boolean  @default(false)
  exceptionCount Int      @default(0)
  summary        Json
  startedAt      DateTime @default(now())
  completedAt    DateTime @default(now())

  @@index([completedAt])
  @@index([balanced, completedAt])
}

model MarketplaceLedgerEntry {
  id          String   @id @default(cuid())
  orderId     String
  paymentId   String?
  refundId    String?
  entryKey    String   @unique
  accountCode String
  direction   String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("INR")
  entryType   String
  metadata    Json?
  createdAt   DateTime @default(now())

  order   MarketplaceOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment MarketplacePayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund  MarketplaceRefund?  @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([refundId])
  @@index([paymentId])
  @@index([accountCode, createdAt])
}
