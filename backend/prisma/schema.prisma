generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PART 01 - PLATFORM ENTITY
// ============================================================

model Entity {
  id        String    @id @default(cuid())
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farms Farm[]

  @@index([type])
  @@index([deletedAt])
}

// ============================================================
// PART 01 END
// ============================================================

// ============================================================
// PART 02 - PERMISSIONS
// ============================================================

model Permission {
  id       String  @id @default(cuid())
  module   String
  section  String?
  resource String?
  action   String
  scope    String

  inherited Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions  RolePermission[]
  accessGrants     AccessGrant[]
  fieldPermissions FieldPermission[]

  @@unique([module, section, resource, action, scope])
  @@index([module])
  @@index([resource])
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model AccessGrant {
  id String @id @default(cuid())

  permissionId String
  userId       String?

  subjectType String
  subjectId   String

  effect String @default("ALLOW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectType, subjectId])
  @@index([permissionId])
}

model FieldPermission {
  id String @id @default(cuid())

  permissionId String

  field  String
  effect String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, field])
  @@index([field])
}

// ============================================================
// PART 02 END
// ============================================================

// ============================================================
// PART 03 - USER ACCOUNT
// ============================================================

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  mobile       String? @unique
  passwordHash String

  role   UserRole   @default(FARMER)
  status UserStatus @default(PENDING)

  preferredLanguage    String?     @default("en")
  preferredInputMethod InputMethod @default(MIXED)

  profileCompletion Int     @default(0)
  isVerified        Boolean @default(false)

  lastSeenAt       DateTime?
  lastLoginAt      DateTime?
  refreshTokenHash String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  deletionRequested   Boolean   @default(false)
  deletionRequestedAt DateTime?
  deletedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms       Farm[]
  auditEvents AuditEvent[] @relation("AuditActor")

  userHistoryEntries       UserHistory[]      @relation("UserHistoryUser")
  userHistoryActions       UserHistory[]      @relation("UserHistoryActor")
  resourceMovementsCreated ResourceMovement[] @relation("ResourceMovementCreatedBy")
  resourceMovementsUpdated ResourceMovement[] @relation("ResourceMovementUpdatedBy")
  resourceLineagesCreated  ResourceLineage[]  @relation("ResourceLineageCreatedBy")
  resourceLineagesUpdated  ResourceLineage[]  @relation("ResourceLineageUpdatedBy")

  resourceRelationships        ResourceRelationship[] @relation("ResourceRelationshipUser")
  createdResourceRelationships ResourceRelationship[] @relation("ResourceRelationshipCreatedBy")
  updatedResourceRelationships ResourceRelationship[] @relation("ResourceRelationshipUpdatedBy")
}

// ============================================================
// PART 03 END
// ============================================================

// ============================================================
// PART 04 - FARM
// ============================================================

model Farm {
  id String @id @default(cuid())

  name        String
  type        String?
  description String?

  location String?

  latitude  Float?
  longitude Float?

  area Float?
  unit String? @default("acre")

  ownerId String

  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id])

  assets  FarmAsset[]
  records FarmRecord[]
  crops   Crop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// ============================================================
// PART 04 END
// ============================================================

// ============================================================
// PART 05 - FARM ASSETS
// ============================================================

model FarmAsset {
  id String @id @default(cuid())

  farmId String

  type String
  name String?

  quantity Float?
  unit     String?

  metadata Json?

  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

// ============================================================
// PART 05 END
// ============================================================

// ============================================================
// PART 06 - FARM RECORDS
// ============================================================

model FarmRecord {
  id String @id @default(cuid())

  farmId String

  category String
  title    String?

  inputMethod InputMethod

  data Json

  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

// ============================================================
// PART 06 END
// ============================================================

// ============================================================
// PART 07 - CROPS
// ============================================================

model Crop {
  id     String @id @default(cuid())
  farmId String

  name    String
  variety String?
  season  CropSeason
  status  CropStatus @default(PLANNED)

  sowingDate  DateTime?
  harvestDate DateTime?

  area Float?
  unit String?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([status])
  @@index([season])
}

// ============================================================
// PART 07 END
// ============================================================

// ============================================================
// PART 08 - SECURITY AUDIT
// ============================================================

model AuditEvent {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action       String
  resourceType String
  resourceId   String?
  description  String?
  metadata     Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// PART 08 END
// ============================================================

// ============================================================
// PART 09 - USER HISTORY & VERSIONING
// ============================================================

model UserHistory {
  id String @id @default(cuid())

  userId  String
  version Int

  action  String
  actorId String?

  user  User  @relation("UserHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("UserHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  beforeData Json?
  afterData  Json?

  changedFields Json?

  createdAt DateTime @default(now())

  @@unique([userId, version])
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ============================================================
// PART 09 END
// ============================================================

// ============================================================
// PART 10 - USER ROLES
// ============================================================

// ============================================================
// PART 05 - RESOURCE RELATIONSHIPS
// ============================================================

model ResourceRelationship {
  id String @id @default(cuid())

  resourceType String
  resourceId   String
  userId       String

  relationshipType ResourceRelationshipType
  status           ResourceRelationshipStatus

  validFrom   DateTime
  validUntil  DateTime?
  endedAt     DateTime?
  endedReason String?

  createdBy String
  updatedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User @relation("ResourceRelationshipUser", fields: [userId], references: [id], onDelete: Restrict)
  creator User @relation("ResourceRelationshipCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User @relation("ResourceRelationshipUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([relationshipType])
  @@index([status])
  @@index([validFrom])
  @@index([validUntil])
  @@index([createdBy])
  @@index([updatedBy])
}

// ============================================================
// PART 05 END
// ============================================================

model ResourceMovement {
  id String @id @default(cuid())

  resourceType String
  resourceId   String
  movementType ResourceMovementType

  sourceUserId            String?
  destinationUserId       String?
  sourceResourceType      String?
  sourceResourceId        String?
  destinationResourceType String?
  destinationResourceId   String?

  sourceRelationshipId      String?
  destinationRelationshipId String?
  previousMovementId        String?

  quantity      Float?
  unit          String?
  effectiveAt   DateTime
  recordedAt    DateTime @default(now())
  reason        String?
  transactionId String?
  evidenceId    String?
  metadata      Json?

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator          User               @relation("ResourceMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater          User               @relation("ResourceMovementUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  previousMovement ResourceMovement?  @relation("ResourceMovementChain", fields: [previousMovementId], references: [id], onDelete: SetNull)
  nextMovements    ResourceMovement[] @relation("ResourceMovementChain")
  lineages         ResourceLineage[]

  @@index([resourceType, resourceId])
  @@index([movementType])
  @@index([sourceUserId])
  @@index([destinationUserId])
  @@index([sourceResourceType, sourceResourceId])
  @@index([destinationResourceType, destinationResourceId])
  @@index([effectiveAt])
  @@index([recordedAt])
  @@index([previousMovementId])
  @@index([createdBy])
  @@index([updatedBy])
}

model ResourceLineage {
  id String @id @default(cuid())

  sourceResourceType String
  sourceResourceId   String
  targetResourceType String
  targetResourceId   String

  lineageType ResourceLineageType
  movementId  String?

  quantity    Float?
  unit        String?
  effectiveAt DateTime
  reason      String?
  metadata    Json?

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movement ResourceMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  creator  User              @relation("ResourceLineageCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User              @relation("ResourceLineageUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([sourceResourceType, sourceResourceId])
  @@index([targetResourceType, targetResourceId])
  @@index([lineageType])
  @@index([movementId])
  @@index([effectiveAt])
  @@index([createdBy])
  @@index([updatedBy])
}

enum ResourceLineageType {
  DERIVED_FROM
  SPLIT_FROM
  MERGED_FROM
  TRANSFERRED_FROM
}

enum ResourceMovementType {
  SALE
  PARTIAL_SALE
  TRANSFER
  PARTIAL_TRANSFER
  LEASE
  LEASE_END
  INHERITANCE
  GIFT
  DONATION
  ALLOCATION
  REALLOCATION
  RETURN
  MERGE
  SPLIT
  RECOVERY
  LOCATION_CHANGE
  CUSTODY_CHANGE
}

enum ResourceRelationshipType {
  OWNER
  CO_OWNER
  LESSEE
  MANAGER
  WORKER
  CUSTODIAN
  CARETAKER
  SERVICE_PROVIDER
  ADVISOR
  VETERINARIAN
  AUTHORIZED_OPERATOR
}

enum ResourceRelationshipStatus {
  ACTIVE
  EXPIRED
  TRANSFERRED
  REVOKED
  TERMINATED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FARMER
  FARM_WORKER
  AGRONOMIST
  VETERINARIAN
  BUYER
  MERCHANT
  FPO
  PARTNER
  FIELD_OFFICER
  DISTRICT_ADMIN
  STATE_ADMIN
  GOVERNMENT
  NGO
  BANK
  LOGISTICS
  AI_AGENT
}

// ============================================================
// PART 10 END
// ============================================================

// ============================================================
// PART 11 - USER STATUS
// ============================================================

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING_DELETE
  DELETED
}

// ============================================================
// PART 11 END
// ============================================================

// ============================================================
// PART 12 - INPUT METHODS
// ============================================================

enum InputMethod {
  VOICE
  MANUAL
  IMAGE
  VIDEO
  MIXED
}

// ============================================================
// PART 12 END
// ============================================================

// ============================================================
// PART 13 - CROP SEASONS
// ============================================================

enum CropSeason {
  KHARIF
  RABI
  ZAID
  PERENNIAL
  UNKNOWN
}

// ============================================================
// PART 13 END
// ============================================================

// ============================================================
// PART 14 - CROP STATUS
// ============================================================

enum CropStatus {
  PLANNED
  SOWN
  GERMINATED
  GROWING
  FLOWERING
  FRUITING
  HARVEST_READY
  HARVESTED
  FAILED
  ARCHIVED
}

// ============================================================
// PART 14 END
// ============================================================
