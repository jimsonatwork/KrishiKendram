generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PART 01 - PLATFORM ENTITY
// ============================================================

model Entity {
  id        String    @id @default(cuid())
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farms Farm[]

  @@index([type])
  @@index([deletedAt])
}

// ============================================================
// PART 01 END
// ============================================================

// ============================================================
// PART 02 - PERMISSIONS
// ============================================================

model Permission {
  id       String  @id @default(cuid())
  module   String
  section  String?
  resource String?
  action   String
  scope    String

  inherited Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions  RolePermission[]
  accessGrants     AccessGrant[]
  fieldPermissions FieldPermission[]

  @@unique([module, section, resource, action, scope])
  @@index([module])
  @@index([resource])
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model AccessGrant {
  id String @id @default(cuid())

  permissionId String
  userId       String?

  subjectType String
  subjectId   String

  effect String @default("ALLOW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectType, subjectId])
  @@index([permissionId])
}

model FieldPermission {
  id String @id @default(cuid())

  permissionId String

  field  String
  effect String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, field])
  @@index([field])
}

// ============================================================
// PART 02 END
// ============================================================

// ============================================================
// PART 03 - USER ACCOUNT
// ============================================================

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  mobile       String? @unique
  passwordHash String

  role   UserRole   @default(FARMER)
  status UserStatus @default(PENDING)

  preferredLanguage    String?     @default("en")
  preferredInputMethod InputMethod @default(MIXED)

  profileCompletion Int     @default(0)
  isVerified        Boolean @default(false)

  lastSeenAt       DateTime?
  lastLoginAt      DateTime?
  refreshTokenHash String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  deletionRequested   Boolean   @default(false)
  deletionRequestedAt DateTime?
  deletedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms       Farm[]
  auditEvents AuditEvent[] @relation("AuditActor")

  userHistoryEntries UserHistory[] @relation("UserHistoryUser")
  userHistoryActions UserHistory[] @relation("UserHistoryActor")
}

// ============================================================
// PART 03 END
// ============================================================

// ============================================================
// PART 04 - FARM
// ============================================================

model Farm {
  id String @id @default(cuid())

  name        String
  type        String?
  description String?

  location String?

  latitude  Float?
  longitude Float?

  area Float?
  unit String? @default("acre")

  ownerId String

  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id])

  assets  FarmAsset[]
  records FarmRecord[]
  crops   Crop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// ============================================================
// PART 04 END
// ============================================================

// ============================================================
// PART 05 - FARM ASSETS
// ============================================================

model FarmAsset {
  id String @id @default(cuid())

  farmId String

  type String
  name String?

  quantity Float?
  unit     String?

  metadata Json?

  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

// ============================================================
// PART 05 END
// ============================================================

// ============================================================
// PART 06 - FARM RECORDS
// ============================================================

model FarmRecord {
  id String @id @default(cuid())

  farmId String

  category String
  title    String?

  inputMethod InputMethod

  data Json

  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

// ============================================================
// PART 06 END
// ============================================================

// ============================================================
// PART 07 - CROPS
// ============================================================

model Crop {
  id     String @id @default(cuid())
  farmId String

  name    String
  variety String?
  season  CropSeason
  status  CropStatus @default(PLANNED)

  sowingDate  DateTime?
  harvestDate DateTime?

  area Float?
  unit String?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([status])
  @@index([season])
}

// ============================================================
// PART 07 END
// ============================================================

// ============================================================
// PART 08 - SECURITY AUDIT
// ============================================================

model AuditEvent {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action       String
  resourceType String
  resourceId   String?
  description  String?
  metadata     Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// PART 08 END
// ============================================================

// ============================================================
// PART 09 - USER HISTORY & VERSIONING
// ============================================================

model UserHistory {
  id String @id @default(cuid())

  userId  String
  version Int

  action  String
  actorId String?

  user  User  @relation("UserHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("UserHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  beforeData Json?
  afterData  Json?

  changedFields Json?

  createdAt DateTime @default(now())

  @@unique([userId, version])
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ============================================================
// PART 09 END
// ============================================================

// ============================================================
// PART 10 - USER ROLES
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FARMER
  FARM_WORKER
  AGRONOMIST
  VETERINARIAN
  BUYER
  MERCHANT
  FPO
  PARTNER
  FIELD_OFFICER
  DISTRICT_ADMIN
  STATE_ADMIN
  GOVERNMENT
  NGO
  BANK
  LOGISTICS
  AI_AGENT
}

// ============================================================
// PART 10 END
// ============================================================

// ============================================================
// PART 11 - USER STATUS
// ============================================================

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING_DELETE
  DELETED
}

// ============================================================
// PART 11 END
// ============================================================

// ============================================================
// PART 12 - INPUT METHODS
// ============================================================

enum InputMethod {
  VOICE
  MANUAL
  IMAGE
  VIDEO
  MIXED
}

// ============================================================
// PART 12 END
// ============================================================

// ============================================================
// PART 13 - CROP SEASONS
// ============================================================

enum CropSeason {
  KHARIF
  RABI
  ZAID
  PERENNIAL
  UNKNOWN
}

// ============================================================
// PART 13 END
// ============================================================

// ============================================================
// PART 14 - CROP STATUS
// ============================================================

enum CropStatus {
  PLANNED
  SOWN
  GERMINATED
  GROWING
  FLOWERING
  FRUITING
  HARVEST_READY
  HARVESTED
  FAILED
  ARCHIVED
}

// ============================================================
// PART 14 END
// ============================================================
