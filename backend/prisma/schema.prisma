generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PART 01 - PLATFORM ENTITY
// ============================================================

// KK-AI-CONVERSATION-FOUNDATION-BEGIN

enum ConversationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ConversationSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
}

enum ConversationMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ConversationMessageSource {
  TEXT
  VOICE
  IMAGE
  DOCUMENT
  SYSTEM
  TOOL
}

enum ConversationFactCandidateStatus {
  DETECTED
  NORMALIZED
  VALIDATION_PENDING
  CONFLICT
  AWAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  APPLIED
  SUPERSEDED
  EXPIRED
}

enum ConversationActionStatus {
  PROPOSED
  PENDING
  EXECUTED
  REJECTED
  FAILED
  CANCELLED
}

model Entity {
  id        String    @id @default(cuid())
  type      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farms Farm[]

  @@index([type])
  @@index([deletedAt])
}

// ============================================================
// GOD MODE - CANONICAL CONFIGURATION REGISTRY
// ============================================================

model GodConfiguration {
  id                   String    @id @default(cuid())
  stableId             String    @unique
  category             String
  name                 String
  description          String?
  currentValue         Json
  valueType            String
  defaultValue         Json?
  allowedValues        Json?
  editable             Boolean   @default(false)
  godOnly              Boolean   @default(true)
  riskLevel            String    @default("LOW")
  restartRequired      Boolean   @default(false)
  approvalRequired     Boolean   @default(false)
  snapshotBeforeChange Boolean   @default(true)
  auditPolicy          String    @default("ALL")
  lifecycle            String    @default("ACTIVE")
  version              Int       @default(1)
  ownerSource          String
  lastActorId          String?
  lastChangedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  dependencies GodConfigurationDependency[] @relation("ConfigDependencies")
  dependents   GodConfigurationDependency[] @relation("ConfigDependents")

  @@index([category])
  @@index([lifecycle])
  @@index([ownerSource])
}

model GodConfigurationDependency {
  id              String   @id @default(cuid())
  configurationId String
  dependsOnId     String
  relationship    String   @default("DEPENDS_ON")
  createdAt       DateTime @default(now())

  configuration GodConfiguration @relation("ConfigDependencies", fields: [configurationId], references: [id], onDelete: Cascade)
  dependsOn     GodConfiguration @relation("ConfigDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([configurationId, dependsOnId])
  @@index([configurationId])
  @@index([dependsOnId])
}

// ============================================================
// PART 01 END
// ============================================================

// ============================================================
// PART 02 - PERMISSIONS
// ============================================================

model Permission {
  id       String  @id @default(cuid())
  module   String
  section  String?
  resource String?
  action   String
  scope    String

  inherited Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions  RolePermission[]
  accessGrants     AccessGrant[]
  fieldPermissions FieldPermission[]

  @@unique([module, section, resource, action, scope])
  @@index([module])
  @@index([resource])
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model AccessGrant {
  id String @id @default(cuid())

  permissionId String
  userId       String?

  subjectType String
  subjectId   String

  effect String @default("ALLOW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectType, subjectId])
  @@index([permissionId])
}

model FieldPermission {
  id String @id @default(cuid())

  permissionId String

  field  String
  effect String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, field])
  @@index([field])
}

// ============================================================
// PART 02 END
// ============================================================

// ============================================================
// PART 03 - USER ACCOUNT
// ============================================================

model User {
  id           String  @id @default(cuid())
  memberId     String? @unique
  name         String
  email        String? @unique
  mobile       String? @unique
  passwordHash String

  role           UserRole           @default(FARMER)
  authorityTier  AuthorityTier      @default(ADMINISTRATIVE)
  status         UserStatus         @default(PENDING)
  userType       UserType           @default(GENERAL)
  approvalStatus UserApprovalStatus @default(PENDING)

  approvedAt            DateTime?
  approvedById          String?
  basicDataVerified     Boolean   @default(false)
  basicDataVerifiedAt   DateTime?
  basicDataVerifiedById String?

  preferredLanguage    String?     @default("en")
  preferredInputMethod InputMethod @default(MIXED)

  profileCompletion Int     @default(0)
  isVerified        Boolean @default(false)

  lastSeenAt       DateTime?
  lastLoginAt      DateTime?
  refreshTokenHash String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  deletionRequested   Boolean   @default(false)
  deletionRequestedAt DateTime?
  deletedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms                         Farm[]
  marketplaceListings           MarketplaceListing[]
  marketplaceSellerProfile      MarketplaceSellerProfile?
  marketplaceFavorites          MarketplaceFavorite[]
  marketplaceMessagesSent       MarketplaceMessage[]      @relation("MarketplaceMessageSender")
  marketplaceMessagesReceived   MarketplaceMessage[]      @relation("MarketplaceMessageRecipient")
  marketplaceRFQs               MarketplaceRFQ[]          @relation("MarketplaceRFQBuyer")
  marketplaceRFQResponses       MarketplaceRFQResponse[]  @relation("MarketplaceRFQSeller")
  marketplaceOrdersAsBuyer      MarketplaceOrder[]        @relation("MarketplaceOrderBuyer")
  marketplaceOrdersAsSeller     MarketplaceOrder[]        @relation("MarketplaceOrderSeller")
  marketplaceReviewsGiven       MarketplaceReview[]       @relation("MarketplaceReviewReviewer")
  marketplaceReviewsReceived    MarketplaceReview[]       @relation("MarketplaceReviewReviewee")
  marketplaceTrustCasesReported MarketplaceTrustCase[]    @relation("MarketplaceTrustReporter")
  marketplaceTrustCasesTargeted MarketplaceTrustCase[]    @relation("MarketplaceTrustTarget")
  marketplaceRestrictions       MarketplaceRestriction[]
  inventoryTransactions         InventoryTransaction[]
  financialRecordsCreated       FarmFinancialRecord[]     @relation("FinancialRecordCreator")
  notifications                 Notification[]
  livestockRecordsCreated       LivestockRecord[]         @relation("LivestockRecordCreator")
  auditEvents                   AuditEvent[]              @relation("AuditActor")

  userHistoryEntries       UserHistory[]      @relation("UserHistoryUser")
  userHistoryActions       UserHistory[]      @relation("UserHistoryActor")
  resourceMovementsCreated ResourceMovement[] @relation("ResourceMovementCreatedBy")
  resourceMovementsUpdated ResourceMovement[] @relation("ResourceMovementUpdatedBy")
  resourceEvidenceCreated  ResourceEvidence[] @relation("ResourceEvidenceCreatedBy")
  resourceEvidenceUpdated  ResourceEvidence[] @relation("ResourceEvidenceUpdatedBy")
  resourceLineagesCreated  ResourceLineage[]  @relation("ResourceLineageCreatedBy")
  resourceLineagesUpdated  ResourceLineage[]  @relation("ResourceLineageUpdatedBy")

  resourceRelationships       ResourceRelationship[]    @relation("ResourceRelationshipUser")
  transferRequestsCreated     ResourceTransferRequest[] @relation("TransferRequestCreatedBy")
  transferRequestsSource      ResourceTransferRequest[] @relation("TransferRequestSourceUser")
  transferRequestsDestination ResourceTransferRequest[] @relation("TransferRequestDestinationUser")
  transferRequestsAccepted    ResourceTransferRequest[] @relation("TransferRequestAcceptedBy")
  transferRequestsRejected    ResourceTransferRequest[] @relation("TransferRequestRejectedBy")
  transferRequestsApproved    ResourceTransferRequest[] @relation("TransferRequestApprovedBy")

  approvedByUser          User?              @relation("User_approvedByIdToUser", fields: [approvedById], references: [id])
  approvedUsers           User[]             @relation("User_approvedByIdToUser")
  basicDataVerifiedByUser User?              @relation("User_basicDataVerifiedByIdToUser", fields: [basicDataVerifiedById], references: [id])
  basicDataVerifiedUsers  User[]             @relation("User_basicDataVerifiedByIdToUser")
  reviewedModuleAccesses  UserModuleAccess[] @relation("UserModuleAccess_reviewedByIdToUser")
  moduleAccessEntries     UserModuleAccess[] @relation("UserModuleAccess_userIdToUser")

  createdResourceRelationships ResourceRelationship[] @relation("ResourceRelationshipCreatedBy")
  updatedResourceRelationships ResourceRelationship[] @relation("ResourceRelationshipUpdatedBy")

  // KK-AI-CONVERSATION-USER-RELATIONS
  aiConversations           Conversation[]              @relation("ConversationUser")
  aiFactCandidates          ConversationFactCandidate[] @relation("ConversationFactCandidateUser")
  aiConfirmedFactCandidates ConversationFactCandidate[] @relation("ConversationFactCandidateConfirmedBy")
}

// ============================================================
// PART 03 END
// ============================================================

// ============================================================
// PART 04 - FARM
// ============================================================

model Farm {
  id String @id @default(cuid())

  name        String
  type        String?
  description String?

  location String?

  latitude  Float?
  longitude Float?

  area Float?
  unit String? @default("acre")

  ownerId String

  entityId String @unique
  entity   Entity @relation(fields: [entityId], references: [id])

  assets           FarmAsset[]
  records          FarmRecord[]
  crops            Crop[]
  livestock        Livestock[]
  inventoryItems   InventoryItem[]
  financialRecords FarmFinancialRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, deletedAt, createdAt])
}

// ============================================================
// PART 04 END
// ============================================================

// ============================================================
// PART 05 - FARM ASSETS
// ============================================================

model FarmAsset {
  id String @id @default(cuid())

  farmId String

  type String
  name String?

  quantity Float?
  unit     String?

  metadata Json?

  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, createdAt])
}

// ============================================================
// PART 05 END
// ============================================================

// ============================================================
// PART 06 - FARM RECORDS
// ============================================================

model FarmRecord {
  id String @id @default(cuid())

  farmId String

  category String
  title    String?

  inputMethod InputMethod

  data Json

  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, createdAt])
}

// ============================================================
// PART 06 END
// ============================================================

// ============================================================
// PART 07 - CROPS
// ============================================================

model Crop {
  id     String @id @default(cuid())
  farmId String

  name    String
  variety String?
  season  CropSeason
  status  CropStatus @default(PLANNED)

  sowingDate  DateTime?
  harvestDate DateTime?

  area Float?
  unit String?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, deletedAt, createdAt])
  @@index([status])
  @@index([season])
}

// ============================================================
// PART 07 END
// ============================================================

// ============================================================
// PART 07A - LIVESTOCK
// ============================================================

model Livestock {
  id     String @id @default(cuid())
  farmId String

  species String
  name    String?
  tag     String?
  breed   String?
  sex     String?
  count   Int     @default(1)
  status  String  @default("ACTIVE")

  acquiredAt DateTime?
  notes      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  farm    Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  records LivestockRecord[]

  @@index([farmId, deletedAt, createdAt])
  @@index([species])
  @@index([status])
  @@index([tag])
}

// ============================================================
// PART 07A END
// ============================================================

// ============================================================
// PART 08 - SECURITY AUDIT
// ============================================================

model MarketplaceListing {
  id                     String    @id @default(cuid())
  sellerId               String
  // Generic listings belong to the registered seller; linked farm resources are optional.
  resourceType           String?
  resourceId             String?
  category               String    @default("OTHER")
  title                  String
  description            String?
  imageUrls              String[]  @default([])
  videoUrls              String[]  @default([])
  externalLinks          String[]  @default([])
  quantity               Float?
  minOrderQuantity       Float?
  priceTiers             Json?
  sellerJurisdictionCode String?
  unit                   String?
  price                  Float?
  currency               String    @default("INR")
  status                 String    @default("DRAFT")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  publishedAt            DateTime?
  deletedAt              DateTime?

  seller    User                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders    MarketplaceOrder[]
  favorites MarketplaceFavorite[]
  messages  MarketplaceMessage[]

  @@index([sellerId, deletedAt, createdAt])
  @@index([resourceType, resourceId])
  @@index([category, status, publishedAt])
  @@index([status, publishedAt])
}

enum LivestockRecordType {
  HEALTH
  VACCINATION
  TREATMENT
  MILK_PRODUCTION
  EGG_PRODUCTION
  WEIGHT
  BREEDING
  FEEDING
  OTHER
}

enum FinancialRecordType {
  INCOME
  EXPENSE
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model MarketplaceOrder {
  id                     String    @id @default(cuid())
  listingId              String
  buyerId                String
  sellerId               String
  quantity               Float
  unitPrice              Float?
  offerPrice             Float?
  agreedUnitPrice        Float?
  subtotal               Decimal?  @db.Decimal(14, 2)
  buyerFeeAmount         Decimal?  @db.Decimal(14, 2)
  sellerCommissionAmount Decimal?  @db.Decimal(14, 2)
  taxAmount              Decimal?  @db.Decimal(14, 2)
  buyerTotal             Decimal?  @db.Decimal(14, 2)
  sellerNet              Decimal?  @db.Decimal(14, 2)
  pricingPolicyVersion   Int?
  pricingSnapshot        Json?
  buyerJurisdictionCode  String?
  currency               String    @default("INR")
  status                 String    @default("PENDING")
  note                   String?
  sellerNote             String?
  deliveryStatus         String?
  deliveryCarrier        String?
  deliveryTrackingNumber String?
  deliveryTrackingUrl    String?
  estimatedDeliveryAt    DateTime?
  dispatchedAt           DateTime?
  deliveredAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  completedAt            DateTime?

  listing             MarketplaceListing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reviews             MarketplaceReview[]
  payments            MarketplacePayment[]
  refunds             MarketplaceRefund[]
  ledgerEntries       MarketplaceLedgerEntry[]
  buyer               User                     @relation("MarketplaceOrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller              User                     @relation("MarketplaceOrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  marketplaceMessages MarketplaceMessage[]

  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([listingId, status])
}

model MarketplaceCommercePolicy {
  id                          String   @id
  version                     Int      @default(1)
  feesEnabled                 Boolean  @default(false)
  buyerFeeBasisPoints         Int      @default(0)
  sellerCommissionBasisPoints Int      @default(0)
  taxEnabled                  Boolean  @default(false)
  taxBasisPoints              Int      @default(0)
  taxReviewReference          String?
  currency                    String   @default("INR")
  updatedById                 String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([updatedAt])
}

model MarketplaceTrustCase {
  id           String    @id @default(cuid())
  caseNumber   String    @unique @default(cuid())
  reporterId   String
  targetUserId String?
  parentCaseId String?
  listingId    String?
  orderId      String?
  type         String    @default("REPORT")
  category     String
  description  String
  evidenceUrls String[]  @default([])
  status       String    @default("OPEN")
  resolution   String?
  assignedToId String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reporter User                   @relation("MarketplaceTrustReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  target   User?                  @relation("MarketplaceTrustTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  parent   MarketplaceTrustCase?  @relation("MarketplaceTrustCaseAppeal", fields: [parentCaseId], references: [id], onDelete: Restrict)
  appeals  MarketplaceTrustCase[] @relation("MarketplaceTrustCaseAppeal")

  @@index([parentCaseId])
  @@index([reporterId, createdAt])
  @@index([targetUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([listingId])
  @@index([orderId])
}

model MarketplaceRestriction {
  id            String    @id @default(cuid())
  userId        String
  scope         String    @default("MARKETPLACE_ALL")
  status        String    @default("ACTIVE")
  reason        String
  evidence      Json?
  cautionRating Int?
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedById   String?
  createdById   String
  sourceCaseId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, scope, status, expiresAt])
  @@index([sourceCaseId])
  @@index([createdById, createdAt])
}

model MarketplaceReview {
  id             String    @id @default(cuid())
  orderId        String
  reviewerId     String
  revieweeId     String
  rating         Int
  comment        String?
  status         String    @default("PENDING")
  sellerResponse String?
  moderatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order    MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reviewer User             @relation("MarketplaceReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User             @relation("MarketplaceReviewReviewee", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([orderId, reviewerId])
  @@index([revieweeId, status, createdAt])
  @@index([orderId, status])
}

model LivestockRecord {
  id          String              @id @default(cuid())
  livestockId String
  type        LivestockRecordType
  description String
  quantity    Float?
  unit        String?
  recordedAt  DateTime            @default(now())
  nextDueAt   DateTime?
  reference   String?
  notes       String?
  createdBy   String
  createdAt   DateTime            @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id], onDelete: Restrict)
  creator   User      @relation("LivestockRecordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([livestockId, recordedAt])
  @@index([livestockId, type, recordedAt])
  @@index([nextDueAt])
  @@index([createdBy, createdAt])
}

model InventoryItem {
  id             String    @id @default(cuid())
  farmId         String
  name           String
  category       String
  unit           String
  quantityOnHand Float     @default(0)
  reorderLevel   Float     @default(0)
  supplier       String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  farm         Farm                   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([farmId, deletedAt, name])
  @@index([category, deletedAt])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  inventoryItemId String
  actorId         String
  type            InventoryTransactionType
  quantity        Float
  quantityBefore  Float
  quantityAfter   Float
  unitCost        Float?
  reference       String?
  notes           String?
  createdAt       DateTime                 @default(now())

  item  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  actor User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model FarmFinancialRecord {
  id         String              @id @default(cuid())
  farmId     String
  type       FinancialRecordType
  category   String
  amount     Float
  currency   String              @default("INR")
  occurredAt DateTime            @default(now())
  reference  String?
  notes      String?
  createdBy  String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?

  farm    Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  creator User @relation("FinancialRecordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([farmId, deletedAt, occurredAt])
  @@index([farmId, type, occurredAt])
  @@index([category, occurredAt])
  @@index([createdBy, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
}

model AuditEvent {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action       String
  resourceType String
  resourceId   String?
  description  String?
  metadata     Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// PART 08 END
// ============================================================

// ============================================================
// PART 09 - USER HISTORY & VERSIONING
// ============================================================

model UserHistory {
  id String @id @default(cuid())

  userId  String
  version Int

  action  String
  actorId String?

  user  User  @relation("UserHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("UserHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  beforeData Json?
  afterData  Json?

  changedFields Json?

  createdAt DateTime @default(now())

  @@unique([userId, version])
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ============================================================
// PART 09 END
// ============================================================

// ============================================================
// PART 10 - USER ROLES
// ============================================================

// ============================================================
// PART 05 - RESOURCE RELATIONSHIPS
// ============================================================

model ResourceRelationship {
  id String @id @default(cuid())

  resourceType String
  resourceId   String
  userId       String

  relationshipType ResourceRelationshipType
  status           ResourceRelationshipStatus

  validFrom   DateTime
  validUntil  DateTime?
  endedAt     DateTime?
  endedReason String?
  evidenceId  String?

  createdBy String
  updatedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation("ResourceRelationshipUser", fields: [userId], references: [id], onDelete: Restrict)
  creator  User              @relation("ResourceRelationshipCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User              @relation("ResourceRelationshipUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  evidence ResourceEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([relationshipType])
  @@index([status])
  @@index([validFrom])
  @@index([validUntil])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([evidenceId])
}

model ResourceTransferRequest {
  id String @id @default(cuid())

  requestNumber     String                        @unique
  resourceType      String
  resourceId        String
  sourceUserId      String
  destinationUserId String
  quantity          Float?
  unit              String?
  status            ResourceTransferRequestStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  effectiveAt DateTime?
  expiresAt   DateTime?

  reason        String?
  transactionId String?
  evidenceId    String?

  createdBy      String
  updatedBy      String
  acceptedBy     String?
  rejectedBy     String?
  approvedBy     String?
  approvalReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resourceEvidence ResourceEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  creator          User              @relation("TransferRequestCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  sourceUser       User              @relation("TransferRequestSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  destinationUser  User              @relation("TransferRequestDestinationUser", fields: [destinationUserId], references: [id], onDelete: Restrict)
  acceptedUser     User?             @relation("TransferRequestAcceptedBy", fields: [acceptedBy], references: [id], onDelete: SetNull)
  rejectedUser     User?             @relation("TransferRequestRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  approvedUser     User?             @relation("TransferRequestApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([sourceUserId, status])
  @@index([destinationUserId, status, requestedAt])
  @@index([sourceUserId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([expiresAt])
}

model ResourceEvidence {
  id String @id @default(cuid())

  evidenceType   ResourceEvidenceType
  referenceType  String
  referenceValue String
  documentNumber String?
  issuer         String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  integrityHash  String?
  metadata       Json?

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator          User                      @relation("ResourceEvidenceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater          User                      @relation("ResourceEvidenceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  relationships    ResourceRelationship[]
  movements        ResourceMovement[]
  transferRequests ResourceTransferRequest[]

  @@index([evidenceType])
  @@index([referenceType, referenceValue])
  @@index([documentNumber])
  @@index([issuedAt])
  @@index([expiresAt])
  @@index([createdBy])
  @@index([updatedBy])
}

