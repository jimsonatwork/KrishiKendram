model ResourceMovement {
  id String @id @default(cuid())

  resourceType String
  resourceId   String
  movementType ResourceMovementType

  sourceUserId            String?
  destinationUserId       String?
  sourceResourceType      String?
  sourceResourceId        String?
  destinationResourceType String?
  destinationResourceId   String?

  sourceRelationshipId      String?
  destinationRelationshipId String?
  previousMovementId        String?

  quantity      Float?
  unit          String?
  effectiveAt   DateTime
  recordedAt    DateTime @default(now())
  reason        String?
  transactionId String?
  evidenceId    String?
  metadata      Json?

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator          User               @relation("ResourceMovementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater          User               @relation("ResourceMovementUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  previousMovement ResourceMovement?  @relation("ResourceMovementChain", fields: [previousMovementId], references: [id], onDelete: SetNull)
  nextMovements    ResourceMovement[] @relation("ResourceMovementChain")
  lineages         ResourceLineage[]
  evidence         ResourceEvidence?  @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([movementType])
  @@index([sourceUserId])
  @@index([destinationUserId])
  @@index([sourceResourceType, sourceResourceId])
  @@index([destinationResourceType, destinationResourceId])
  @@index([effectiveAt])
  @@index([recordedAt])
  @@index([previousMovementId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([evidenceId])
}

model ResourceLineage {
  id String @id @default(cuid())

  sourceResourceType String
  sourceResourceId   String
  targetResourceType String
  targetResourceId   String

  lineageType ResourceLineageType
  movementId  String?

  quantity    Float?
  unit        String?
  effectiveAt DateTime
  reason      String?
  metadata    Json?

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movement ResourceMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  creator  User              @relation("ResourceLineageCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User              @relation("ResourceLineageUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([sourceResourceType, sourceResourceId])
  @@index([targetResourceType, targetResourceId])
  @@index([lineageType])
  @@index([movementId])
  @@index([effectiveAt])
  @@index([createdBy])
  @@index([updatedBy])
}

