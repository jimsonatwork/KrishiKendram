model MarketplaceRFQResponse {
  id                String         @id @default(cuid())
  rfqId             String
  sellerId          String
  unitPrice         Decimal        @db.Decimal(14, 2)
  availableQuantity Float
  note              String?
  validUntil        DateTime?
  status            String         @default("SUBMITTED")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  rfq               MarketplaceRFQ @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  seller            User           @relation("MarketplaceRFQSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([rfqId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([rfqId, status, createdAt])
